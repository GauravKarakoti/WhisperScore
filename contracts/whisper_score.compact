pragma compiler_version >= 0.14.0;

// PUBLIC STATE
export ledger requiredThreshold: Uint<32>;
// Add a mapping to store if a user is eligible, fulfilling the "State Transition" requirement
export ledger eligibilityRecord: Map<Bytes<32>, Boolean>;

constructor(initialThreshold: Uint<32>) {
  requiredThreshold = disclose(initialThreshold);
}

// PRIVATE WITNESS
witness privateUserValue(): Uint<32>;

export circuit checkEligibility(userAddress: Bytes<32>): Boolean {
  const threshold = requiredThreshold;
  const userValue = privateUserValue();
  
  // Compute the comparison privately
  const isEligible = userValue >= threshold;
  
  // STATE TRANSITION: Record the outcome on-chain without exposing the underlying score
  eligibilityRecord.insert(userAddress, isEligible);
  
  // Deliberately disclose the boolean result (Eligible/Not Eligible)
  return disclose(isEligible);
}