pragma compiler_version >= 0.14.0;

export ledger requiredThreshold: Uint<32>;
export ledger eligibleCount: Uint<32>;

constructor(initialThreshold: Uint<32>) {
  requiredThreshold = disclose(initialThreshold);
  eligibleCount = 0;
}

// MULTI-CHAIN WITNESS: Read public state from another chain (e.g., Ethereum)
witness externalChainBalance(): Uint<32>;
// Simulates an Affect Stream or Oracle signature verifying the external state
witness stateSignature(): Bytes<32>; 

export circuit checkEligibility(): Boolean {
  const threshold = requiredThreshold;
  
  // Pull the multi-chain data privately into the local circuit
  const balance = externalChainBalance();
  const signature = stateSignature();
  
  // In a production Affect Stream integration, you would assert the validity 
  // of the signature or Merkle proof here to prevent spoofing:
  // assert verifySignature(signature, ...);
  
  // Compute the comparison privately
  const isEligible = balance >= threshold;
  
  // Convert boolean to numeric increment and disclose to the public ledger
  const increment = (isEligible as Field) as Uint<32>;
  eligibleCount = disclose((eligibleCount + increment) as Uint<32>);
  
  return disclose(isEligible);
}